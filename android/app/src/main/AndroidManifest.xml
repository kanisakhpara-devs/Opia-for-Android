<?xml version="1.0" encoding="utf-8"?>
<!-- Opia only goes online to check GitHub for a new version of itself, and only after you've allowed it in the app.
     The page you see can't reach the internet at all; only the update code in MainActivity can, and only to GitHub. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Groove records your voice; WebView needs both of these for the microphone -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- updates: ask GitHub for the newest release, download it, and hand it to Android's installer -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="Opia"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Opia"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:hardwareAccelerated="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- home-screen widgets: two quote layouts, photo of the day, favourites, quick create, recent PDFs, pick up where you left off -->
        <receiver android:name=".Widgets$QuoteCard" android:label="@string/w_quote_card" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_quote_card_info" />
        </receiver>
        <receiver android:name=".Widgets$QuoteStrip" android:label="@string/w_quote_strip" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_quote_strip_info" />
        </receiver>
        <receiver android:name=".Widgets$Photo" android:label="@string/w_photo" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_photo_info" />
        </receiver>
        <receiver android:name=".Widgets$Favourites" android:label="@string/w_favs" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_favs_info" />
        </receiver>
        <receiver android:name=".Widgets$Quick" android:label="@string/w_quick" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_quick_info" />
        </receiver>
        <receiver android:name=".Widgets$RecentPdfs" android:label="@string/w_pdfs" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_pdfs_info" />
        </receiver>
        <receiver android:name=".Widgets$Resume" android:label="@string/w_resume" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_resume_info" />
        </receiver>

        <!-- hands files to other apps when you tap Share -->
        <provider
            android:name=".ShareProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
