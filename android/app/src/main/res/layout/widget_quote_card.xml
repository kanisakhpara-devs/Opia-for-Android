<?xml version="1.0" encoding="utf-8"?>
<!-- Quote of the day, the tall card (design A): a gold quotation mark, the quote, then the logo, who said it and where -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:padding="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/mark" android:layout_width="0dp" android:layout_weight="1" android:layout_height="34dp"
                android:text="“" android:textColor="#E2B93B" android:textSize="60sp" android:fontFamily="@font/nunito_extrabold"
                android:includeFontPadding="false" android:importantForAccessibility="no" />
            <!-- the only way to another quote: a small button, so a stray tap on the card doesn't change it -->
            <ImageView android:id="@+id/shuffle" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginTop="-8dp" android:layout_marginEnd="-8dp"
                android:padding="9dp" android:src="@drawable/ic_shuffle" android:background="@drawable/widget_press" android:contentDescription="@string/another_quote" />
        </LinearLayout>
        <TextView android:id="@+id/quote" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:layout_marginTop="2dp" android:gravity="top|start"
            android:text="The empires of the future are the empires of the mind." android:textColor="#F4F1EA"
            android:fontFamily="@font/nunito_extrabold" android:textSize="24sp" android:lineSpacingMultiplier="1.08"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="13sp" android:autoSizeMaxTextSize="26sp" android:autoSizeStepGranularity="1sp"
            android:ellipsize="end" />
        <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:layout_marginBottom="12dp"
            android:background="#24FFFFFF" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/logo" android:layout_width="38dp" android:layout_height="38dp" android:src="@drawable/ws_lens"
                android:contentDescription="@string/open_opia" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                <TextView android:id="@+id/by" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Winston Churchill"
                    android:textColor="#F4F1EA" android:textSize="15sp" android:fontFamily="@font/nunito_extrabold" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/src" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Harvard University, 1943"
                    android:textColor="#9D9BA0" android:textSize="12sp" android:fontFamily="@font/nunito_semibold" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
