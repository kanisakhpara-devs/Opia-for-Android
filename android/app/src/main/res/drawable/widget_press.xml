<?xml version="1.0" encoding="utf-8"?>
<!-- a light wash where you press, inside a card -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape><solid android:color="#22FFFFFF" /><corners android:radius="14dp" /></shape></item>
    <item><shape><solid android:color="#00000000" /><corners android:radius="14dp" /></shape></item>
</selector>
